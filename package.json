{
  "name": "orders-portal",
  "version": "1.0.0",
  "description": "Order Portal — Failed Orders Management on SAP BTP",
  "private": true,
  "dependencies": {
    "@cap-js/postgres": "^2",
    "@octanner/cap-postgres-onprem-connector": "file:libs/octanner-cap-postgres-onprem-connector-1.0.2.tgz",
    "@sap-cloud-sdk/connectivity": "^4.8.0",
    "@sap-cloud-sdk/http-client": "^4.8.0",
    "@sap/cds": "^9",
    "@sap/xsenv": "^6.2.1",
    "@sap/xssec": "^4",
    "axios": "^1.11.0",
    "pg": "^8.16.3",
    "socks": "^2.8.9"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.10"
  },
  "scripts": {
    "start": "cds run",
    "watch": "cds watch",
    "watch-failedorders": "cds watch --open orders.portal.failedorders/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-allorders": "cds watch --open orders.portal.allorders/index.html?sap-ui-xx-viewCache=false --livereload false",
    "build": "npx rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "undeploy": "cf undeploy orders-portal --delete-services --delete-service-keys --delete-service-brokers"
  },
